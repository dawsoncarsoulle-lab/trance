hell0_world() {
    return "Hello world";
}

sayHelloWorld() {
    print("Hello world");
}

read_file(string filename) void {
    content := read filename
    print(content)
}


addition(int a, int b) {
    int c := a + b;
    return c;
}

ge(int a, int b) int {
    if a > b then return a
    return b
}

elseifStatement(int a, int b) {
    elseif a < b then print(a)
}

elseStatement(int  a) {
    else print(a)
}

whileLoop (int a) {
    while a < 10 do
      a += 1
    end
}
